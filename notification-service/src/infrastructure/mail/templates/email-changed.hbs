<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<title>Ваш код подтверждения смены почты</title>
	</head>
	<body>
		<table style='width: 100%;' cellpadding:='0' cellspacing='0'>
			<tr>
				<td align='center' style='padding: 40px;'>
					<table
						width='100%'
						cellpadding:='0'
						cellspacing='0'
						style='max-width: 480px; width: 100%;'
					>
						<tr>
                            <td align="left" style="padding: 0 20px;">
							<h2
								style='font-size: 22px; font-weight: 600; margin: 0 0 15px;'
							>
								Подтверждения смены почты
							</h1>
							<p style='font-size: 15px; margin:  0 0 15px;'>Ваш
								код подтверждения смены почты:
							</p>
							<div
								style='font-size: 36px; font-weight: bold; letter-spacing: 6px; margin: 18px 0;'
							>
								{{code}}
							</div>

							<p
								style='font-size: 14px; line-height: 1.5; margin: 0 0 20px;'
							>
								Если вы не запрашвали смену почты - просто
								игнорируйте это письмо
							</p>
                            </td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>